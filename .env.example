# Django Configuration
DJANGO_SECRET_KEY=replace-with-your-own-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database Configuration (PostgreSQL)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=homepilot_db
DB_USER=postgres
DB_PASSWORD=replace-with-your-own-password
DB_HOST=localhost
DB_PORT=5432

# Celery & Redis Configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_ALWAYS_EAGER=True

# AI Bill Extraction
# Options: mock | gemini | openai
BILL_EXTRACTION_BACKEND=mock
GEMINI_API_KEY=
OPENAI_API_KEY=

# Email Notifications
# In development, console backend prints emails directly to stdout
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=HomePilot <notifications@homepilot.local>
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
