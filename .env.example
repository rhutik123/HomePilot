# ==============================================================================
# HomePilot Environment Configuration Template
# Copy this file to .env and adjust variables for your local or production setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# Django Core Settings
# ------------------------------------------------------------------------------
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=change-this-to-a-strong-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# For zero-dependency local development and testing, use SQLite:
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# For PostgreSQL production / staging deployment, uncomment and configure:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=homepilot_db
# DB_USER=postgres
# DB_PASSWORD=your_secure_password
# DB_HOST=localhost
# DB_PORT=5432

# ------------------------------------------------------------------------------
# Celery & Asynchronous Task Processing
# ------------------------------------------------------------------------------
# Set CELERY_TASK_ALWAYS_EAGER=True to execute tasks synchronously in-process
# (ideal for local testing and development without a running Redis daemon)
CELERY_TASK_ALWAYS_EAGER=True
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# AI Provider & Document Intelligence
# ------------------------------------------------------------------------------
# Options: 'mock' (offline deterministic extraction/tools) | 'gemini' (live Google Gemini 2.5)
BILL_EXTRACTION_BACKEND=mock
GEMINI_API_KEY=
# Custom Tesseract OCR binary path (optional, auto-detected in PATH if omitted)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ------------------------------------------------------------------------------
# Multi-Channel Notifications
# ------------------------------------------------------------------------------
# 1. Email (Console backend prints formatted emails to stdout in development)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=HomePilot <notifications@homepilot.local>
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False

# 2. WhatsApp Business Cloud API (Meta Graph API)
# Leave blank for simulated sandbox execution with structured audit delivery logging
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
